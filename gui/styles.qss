/* Estilos globales para la aplicación Desafío 4 */

QMainWindow {
    background-color: #fafafa;
}

QGroupBox {
    font-weight: bold;
    font-size: 12px;
    color: #000000;
    border: 1px solid #cccccc;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #1565c0;
}

QPushButton {
    background-color: #e0e0e0;
    color: #000000;
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton:hover {
    background-color: #d5d5d5;
    border-color: #9e9e9e;
}

QPushButton:pressed {
    background-color: #cccccc;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #666666;
    border-color: #e0e0e0;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    padding: 4px 8px;
    background: white;
    font-size: 12px;
    color: #000000;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #90caf9;
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2196f3;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: #000000;
    border: 1px solid #bdbdbd;
    selection-background-color: #2196f3;
    selection-color: #ffffff;
}

QProgressBar {
    border: 1px solid #cccccc;
    border-radius: 4px;
    text-align: center;
    background-color: #f0f0f0;
    font-size: 11px;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #2196f3;
    border-radius: 3px;
}

QTabWidget::pane {
    border: 1px solid #cccccc;
    background: white;
    border-radius: 4px;
}

QTabBar::tab {
    background: #e0e0e0;
    border: 1px solid #cccccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    font-size: 12px;
    color: #000000;
}

QTabBar::tab:selected {
    background: #2196f3;
    color: #ffffff;
    border-color: #1976d2;
}

QTabBar::tab:hover:!selected {
    background: #f5f5f5;
}

QLabel {
    color: #000000;
}

QScrollArea {
    border: 1px solid #bdbdbd;
    background: #fafafa;
}
